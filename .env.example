# --- Database (Postgres + PostGIS, e.g. Supabase or Neon) ---
DATABASE_URL="postgresql://user:password@localhost:5432/raksha?schema=public"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# Social login providers (Tier 1 reporter verification)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Dev-only credentials login (disable in production). Never a substitute for
# the real social + OTP + ID verification flow described in the build brief.
ENABLE_DEV_LOGIN="true"
NEXT_PUBLIC_DEV_LOGIN_ENABLED="true" # must match ENABLE_DEV_LOGIN — client needs it to show the form

# --- Phone OTP (MSG91 preferred for India, Twilio Verify as fallback) ---
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# --- Storage (Supabase Storage or Cloudflare R2) ---
STORAGE_BUCKET_PHOTOS="raksha-case-photos"
STORAGE_BUCKET_DOCS="raksha-verification-docs" # private, encrypted, admin-only
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"

# --- AI (Anthropic) ---
ANTHROPIC_API_KEY=""
# Model used for photo triage + duplicate image comparison. Configurable
# because model IDs change; do not hardcode a stale one in application code.
ANTHROPIC_TRIAGE_MODEL="claude-sonnet-4-5"

# --- Maps ---
NEXT_PUBLIC_MAPS_PROVIDER="maplibre" # "maplibre" (OSM, free) or "google"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# --- WhatsApp (manual number at first; Cloud API later) ---
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
