# --- Database (Postgres + PostGIS, e.g. Supabase or Neon) ---
# On Supabase: DATABASE_URL = the "Transaction" pooler string (port 6543,
# includes ?pgbouncer=true), DIRECT_URL = the direct connection (port
# 5432) — Settings > Database > Connection string has both. Locally,
# these can be the same value.
DATABASE_URL="postgresql://user:password@localhost:5432/raksha?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/raksha?schema=public"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# Social login providers (Tier 1 reporter verification)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Dev-only credentials login (disable in production). Never a substitute for
# the real social + OTP + ID verification flow described in the build brief.
ENABLE_DEV_LOGIN="true"
NEXT_PUBLIC_DEV_LOGIN_ENABLED="true" # must match ENABLE_DEV_LOGIN — client needs it to show the form

# --- Phone OTP (MSG91 preferred for India, Twilio Verify as fallback) ---
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# --- Storage (Supabase Storage) ---
# Leave both blank for local dev — src/lib/storage.ts falls back to
# writing under public/uploads/. Set both to switch to Supabase Storage
# (needed for any real deployment: serverless hosts like Vercel have no
# persistent local disk). Project Settings > API has both values.
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security — server-only,
# never expose it to the client or commit it.
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
STORAGE_BUCKET_PHOTOS="raksha-case-photos" # public bucket — create it once in the Supabase dashboard
STORAGE_BUCKET_DOCS="raksha-verification-docs" # separate PRIVATE bucket, admin-only — not wired up yet, ID/compliance docs are out of scope for this pass

# --- AI (Anthropic) ---
ANTHROPIC_API_KEY=""
# Model used for photo triage + duplicate image comparison. Configurable
# because model IDs change; do not hardcode a stale one in application code.
ANTHROPIC_TRIAGE_MODEL="claude-sonnet-4-5"

# --- Maps ---
NEXT_PUBLIC_MAPS_PROVIDER="maplibre" # "maplibre" (OSM, free) or "google"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# --- WhatsApp (manual number at first; Cloud API later) ---
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
